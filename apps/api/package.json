{
  "name": "@ys-dashboard/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "npm run build -w @ys-dashboard/shared && tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "npm run build -w @ys-dashboard/shared && drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "db:seed": "tsx src/seed.ts",
    "db:import": "tsx src/import.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@neondatabase/serverless": "^1.0.2",
    "@ys-dashboard/shared": "*",
    "csv-parse": "^6.1.0",
    "drizzle-orm": "^0.44.7",
    "exceljs": "^4.4.0",
    "fastify": "^5.6.1"
  },
  "devDependencies": {
    "@types/node": "^24.6.2",
    "drizzle-kit": "^0.31.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
